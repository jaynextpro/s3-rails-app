<% content_for :title, "Subir imagen a S3" %>

<% content_for :head do %>
  <style>
    :root {
      --brand: #2563eb;
      --brand-dark: #1d4ed8;
      --bg: #eef2f9;
      --text: #1f2937;
      --muted: #6b7280;
      --border: #d8dee9;
      --danger: #dc2626;
      --danger-dark: #b91c1c;
      --success: #16a34a;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
      background: linear-gradient(160deg, #eef2f9 0%, #dbe4f5 100%);
      color: var(--text);
      min-height: 100vh;
    }
    .upload-page {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      padding: 24px;
    }
    .upload-card {
      width: 100%;
      max-width: 480px;
      background: #fff;
      border-radius: 18px;
      box-shadow: 0 12px 40px rgba(15, 23, 42, 0.12);
      padding: 36px 32px;
    }
    .upload-card__header { text-align: center; margin-bottom: 24px; }
    .upload-card__icon {
      width: 56px; height: 56px;
      margin: 0 auto 14px;
      display: flex; align-items: center; justify-content: center;
      background: var(--brand); color: #fff;
      border-radius: 14px; font-size: 26px;
    }
    .upload-card h1 { margin: 0 0 6px; font-size: 22px; }
    .upload-card__header p { margin: 0; color: var(--muted); font-size: 14px; }

    .dropzone {
      display: flex; flex-direction: column; align-items: center;
      gap: 6px; text-align: center;
      padding: 32px 20px;
      border: 2px dashed var(--border);
      border-radius: 14px;
      cursor: pointer;
      transition: border-color .15s ease, background .15s ease;
    }
    .dropzone:hover, .dropzone.is-dragover { border-color: var(--brand); background: #f5f8ff; }
    .dropzone.has-file { border-style: solid; border-color: var(--brand); background: #f5f8ff; }
    .dropzone__title { font-weight: 600; font-size: 15px; }
    .dropzone__title b { color: var(--brand); }
    .dropzone__hint { font-size: 12.5px; color: var(--muted); }
    .dropzone svg { color: var(--brand); margin-bottom: 4px; }

    .visually-hidden {
      position: absolute; width: 1px; height: 1px;
      padding: 0; margin: -1px; overflow: hidden;
      clip: rect(0 0 0 0); white-space: nowrap; border: 0;
    }

    .field-error {
      display: none;
      margin: 12px 0 0;
      color: var(--danger);
      font-size: 13px;
    }
    .field-error.is-visible { display: block; }

    .btn {
      width: 100%;
      margin-top: 18px;
      padding: 13px 20px;
      background: var(--brand);
      color: #fff;
      font-size: 15px; font-weight: 600;
      border: none; border-radius: 10px;
      cursor: pointer;
      transition: background .15s ease;
    }
    .btn:hover:not(:disabled) { background: var(--brand-dark); }
    .btn:disabled { opacity: .65; cursor: not-allowed; }

    .btn--secondary {
      background: #fff;
      color: var(--brand);
      border: 1px solid var(--border);
    }
    .btn--secondary:hover:not(:disabled) { background: #f5f8ff; }

    .result {
      display: none;
      margin-top: 22px;
      padding: 16px;
      border-radius: 12px;
      font-size: 14px;
    }
    .result.is-visible { display: block; }
    .result.is-success { background: #ecfdf3; color: var(--success); }
    .result.is-error { background: #fef2f2; color: var(--danger); }
    .result img {
      display: none;
      max-width: 100%;
      margin-top: 12px;
      border-radius: 10px;
    }

    /* --- Object list / delete --- */
    .divider { margin: 30px 0 0; border: none; border-top: 1px solid var(--border); }
    .objects-title { font-size: 16px; margin: 22px 0 4px; }
    .objects-note { font-size: 12.5px; color: var(--muted); margin: 0 0 14px; }
    .objects-empty { font-size: 13px; color: var(--muted); margin-top: 14px; }

    .object-item {
      display: flex; align-items: center; gap: 12px;
      padding: 10px; margin-top: 10px;
      border: 1px solid var(--border); border-radius: 12px;
    }
    .object-item img {
      width: 56px; height: 56px;
      object-fit: cover; border-radius: 8px;
      background: #f0f0f0;
    }
    .object-item__info { flex: 1; font-size: 12.5px; word-break: break-all; }
    .object-item__info .name { font-weight: 600; }
    .object-item__info .meta { color: var(--muted); margin-top: 2px; }

    .btn--danger {
      flex-shrink: 0;
      padding: 7px 12px;
      background: var(--danger); color: #fff;
      font-size: 13px; font-weight: 600;
      border: none; border-radius: 8px;
      cursor: pointer;
      transition: background .15s ease;
    }
    .btn--danger:hover:not(:disabled) { background: var(--danger-dark); }
    .btn--danger:disabled { opacity: .65; cursor: not-allowed; }
  </style>
<% end %>

<main class="upload-page">
  <section class="upload-card">
    <header class="upload-card__header">
      <div class="upload-card__icon" aria-hidden="true">&#9729;</div>
      <h1>Subir imagen a S3</h1>
      <p>Selecciona una imagen y la guardaremos en tu bucket de Amazon S3.</p>
    </header>

    <%= form_with url: uploads_path, multipart: true, id: "upload-form", html: { novalidate: true } do |f| %>
      <label class="dropzone" id="dropzone" for="image-input">
        <svg width="34" height="34" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="17 8 12 3 7 8"></polyline>
          <line x1="12" y1="3" x2="12" y2="15"></line>
        </svg>
        <span class="dropzone__title" id="dropzone-title">
          <b>Haz clic para elegir</b> o arrastra una imagen
        </span>
        <span class="dropzone__hint">JPG, PNG, GIF o WEBP &middot; m&aacute;x. 10 MB</span>
      </label>
      <%= f.file_field :image, accept: "image/*", id: "image-input", class: "visually-hidden" %>

      <p class="field-error" id="field-error" role="alert"></p>

      <%= f.submit "Subir a S3", id: "submit-btn", class: "btn" %>
    <% end %>

    <div id="result" class="result" role="status" aria-live="polite">
      <strong id="message"></strong>
      <img id="preview" src="" alt="Imagen subida">
    </div>

    <hr class="divider">

    <h2 class="objects-title">Objetos en el bucket</h2>
    <p class="objects-note">Los enlaces de vista previa son temporales y expiran a los 60 segundos &mdash; vuelve a pulsar "Listar objetos" para actualizarlos.</p>
    <button type="button" id="list-btn" class="btn btn--secondary">Listar objetos</button>
    <div id="objects"></div>
  </section>
</main>

<script>
  (function () {
    var MAX_FILE_SIZE = 10 * 1024 * 1024;
    var ALLOWED_TYPES = ['image/jpeg', 'image/png', 'image/gif', 'image/webp'];

    var form        = document.getElementById('upload-form');
    var input       = document.getElementById('image-input');
    var dropzone    = document.getElementById('dropzone');
    var dzTitle     = document.getElementById('dropzone-title');
    var submitBtn   = document.getElementById('submit-btn');
    var fieldError  = document.getElementById('field-error');
    var result      = document.getElementById('result');
    var message     = document.getElementById('message');
    var preview     = document.getElementById('preview');
    var listBtn     = document.getElementById('list-btn');
    var objectsDiv  = document.getElementById('objects');

    function csrfToken() {
      return document.querySelector('meta[name=csrf-token]')?.content || '';
    }

    function showFieldError(text) {
      fieldError.textContent = text;
      fieldError.classList.add('is-visible');
    }

    function clearFieldError() {
      fieldError.textContent = '';
      fieldError.classList.remove('is-visible');
    }

    function showResult(text, isSuccess) {
      message.textContent = text;
      result.className = 'result is-visible ' + (isSuccess ? 'is-success' : 'is-error');
    }

    // Returns an error string, or null if the file is valid.
    function validate(file) {
      if (!file) { return 'Por favor selecciona una imagen antes de subir.'; }
      if (ALLOWED_TYPES.indexOf(file.type) === -1) {
        return 'Formato no válido. Usa una imagen JPG, PNG, GIF o WEBP.';
      }
      if (file.size > MAX_FILE_SIZE) {
        return 'La imagen supera el tamaño máximo permitido de 10 MB.';
      }
      return null;
    }

    function refreshDropzone() {
      var file = input.files[0];
      if (file) {
        dropzone.classList.add('has-file');
        dzTitle.innerHTML = '<b></b>';
        dzTitle.querySelector('b').textContent = file.name;
      } else {
        dropzone.classList.remove('has-file');
        dzTitle.innerHTML = '<b>Haz clic para elegir</b> o arrastra una imagen';
      }
    }

    input.addEventListener('change', function () {
      clearFieldError();
      refreshDropzone();
    });

    // Drag-and-drop support.
    ['dragenter', 'dragover'].forEach(function (evt) {
      dropzone.addEventListener(evt, function (e) {
        e.preventDefault();
        dropzone.classList.add('is-dragover');
      });
    });
    ['dragleave', 'drop'].forEach(function (evt) {
      dropzone.addEventListener(evt, function (e) {
        e.preventDefault();
        dropzone.classList.remove('is-dragover');
      });
    });
    dropzone.addEventListener('drop', function (e) {
      if (e.dataTransfer && e.dataTransfer.files.length) {
        input.files = e.dataTransfer.files;
        clearFieldError();
        refreshDropzone();
      }
    });

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      clearFieldError();

      var file = input.files[0];
      var error = validate(file);
      if (error) {
        showFieldError(error);
        return;
      }

      submitBtn.disabled = true;
      submitBtn.value = 'Subiendo…';

      try {
        var res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: {
            'X-CSRF-Token': csrfToken(),
            'Accept': 'application/json'
          }
        });

        var data;
        try {
          data = await res.json();
        } catch (parseErr) {
          throw new Error('El servidor devolvió una respuesta inesperada.');
        }

        showResult(data.message || (res.ok ? 'Listo.' : 'No se pudo subir la imagen.'), res.ok && data.success);

        if (data.success && data.data && data.data.url) {
          preview.src = data.data.url;
          preview.style.display = 'block';
        } else {
          preview.style.display = 'none';
        }
      } catch (err) {
        showResult(err.message || 'No se pudo conectar con el servidor.', false);
        preview.style.display = 'none';
      } finally {
        submitBtn.disabled = false;
        submitBtn.value = 'Subir a S3';
      }
    });

    // --- List & delete bucket objects ---
    function formatSize(bytes) {
      if (bytes < 1024) { return bytes + ' B'; }
      if (bytes < 1024 * 1024) { return (bytes / 1024).toFixed(1) + ' KB'; }
      return (bytes / 1024 / 1024).toFixed(1) + ' MB';
    }

    function showObjectsMessage(text) {
      objectsDiv.innerHTML = '';
      var p = document.createElement('p');
      p.className = 'objects-empty';
      p.textContent = text;
      objectsDiv.appendChild(p);
    }

    function renderObject(obj) {
      var item = document.createElement('div');
      item.className = 'object-item';

      var img = document.createElement('img');
      img.src = obj.url;
      img.alt = obj.key;

      var info = document.createElement('div');
      info.className = 'object-item__info';
      var name = document.createElement('div');
      name.className = 'name';
      name.textContent = obj.key;
      var meta = document.createElement('div');
      meta.className = 'meta';
      meta.textContent = formatSize(obj.size) + ' · ' + new Date(obj.last_modified).toLocaleString();
      info.appendChild(name);
      info.appendChild(meta);

      var del = document.createElement('button');
      del.type = 'button';
      del.className = 'btn--danger';
      del.textContent = 'Eliminar';
      del.addEventListener('click', function () { deleteObject(obj.key, item, del); });

      item.appendChild(img);
      item.appendChild(info);
      item.appendChild(del);
      objectsDiv.appendChild(item);
    }

    listBtn.addEventListener('click', async function () {
      listBtn.disabled = true;
      listBtn.textContent = 'Cargando…';
      try {
        var res = await fetch(form.action, { headers: { 'Accept': 'application/json' } });
        var data = await res.json();
        var objects = (data.data && data.data.objects) || [];
        if (objects.length === 0) {
          showObjectsMessage('El bucket está vacío.');
        } else {
          objectsDiv.innerHTML = '';
          objects.forEach(renderObject);
        }
      } catch (err) {
        showObjectsMessage('No se pudieron cargar los objetos.');
      } finally {
        listBtn.disabled = false;
        listBtn.textContent = 'Listar objetos';
      }
    });

    async function deleteObject(key, item, btn) {
      if (!confirm('¿Eliminar "' + key + '" de S3? Esta acción no se puede deshacer.')) { return; }
      btn.disabled = true;
      btn.textContent = 'Eliminando…';
      try {
        var res = await fetch(form.action + '?key=' + encodeURIComponent(key), {
          method: 'DELETE',
          headers: { 'X-CSRF-Token': csrfToken(), 'Accept': 'application/json' }
        });
        var data = await res.json();
        if (res.ok && data.success) {
          item.remove();
        } else {
          throw new Error(data.message || 'No se pudo eliminar el objeto.');
        }
      } catch (err) {
        btn.disabled = false;
        btn.textContent = 'Eliminar';
        alert(err.message || 'No se pudo eliminar el objeto.');
      }
    }
  })();
</script>
